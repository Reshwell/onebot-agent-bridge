# Copy to .env and replace this local bridge token with your own random value.
QBRIDGE_TOKEN=replace-with-a-random-bridge-token
QBRIDGE_HOST=127.0.0.1
QBRIDGE_PORT=8787
QBRIDGE_URL=http://127.0.0.1:8787
QBRIDGE_STATE_DIR=./data
QBRIDGE_FILE_ROOT=./shared

# forward: bridge connects to OneBot's universal WebSocket.
# reverse: OneBot connects to ws://bridge:8787/onebot/v11/ws.
# http: OneBot posts events to http://bridge:8787/events; API uses HTTP.
ONEBOT_MODE=forward
ONEBOT_WS_URL=ws://127.0.0.1:3001/
ONEBOT_ACCESS_TOKEN=
# Optional in forward/reverse mode; required in http mode.
# Set only when you want all actions to use a separate HTTP API.
ONEBOT_HTTP_URL=
# Optional separate HTTP API token; otherwise ONEBOT_ACCESS_TOKEN is used.
ONEBOT_HTTP_ACCESS_TOKEN=
# HMAC-SHA1 secret for HTTP events. Required unless event Bearer auth is used.
ONEBOT_HTTP_SECRET=
# Optional account pin; one daemon handles one QQ account.
ONEBOT_SELF_ID=

QBRIDGE_GROUP_MENTION_ONLY=true
# Only @bot group messages enter the pending queue; include preceding context.
QBRIDGE_GROUP_CONTEXT_LIMIT=20
# Optional comma-separated allowlists. Empty means all users/groups.
QBRIDGE_ALLOWED_USERS=
QBRIDGE_ALLOWED_GROUPS=
QBRIDGE_API_TIMEOUT_MS=15000
QBRIDGE_MAX_HISTORY=10000
QBRIDGE_MAX_MEDIA_BYTES=10485760
# For file-upload extensions: path seen by NapCat/SnowLuma for FILE_ROOT.
# In Docker, mount the same folder into both containers at /shared.
ONEBOT_FILE_ROOT=

# Incoming images: allowed download domains, including their subdomains.
# Signed URLs stay in the private state DB; getImage returns bytes, not URLs.
QBRIDGE_IMAGE_ALLOWED_HOSTS=qpic.cn,multimedia.nt.qq.com,multimedia.nt.qq.com.cn
QBRIDGE_IMAGE_TIMEOUT_MS=15000
# Keep false for QQ CDN images. Only enable for explicitly trusted LAN sources.
QBRIDGE_IMAGE_ALLOW_PRIVATE_NETWORK=false
# Optional read-only shared backend image cache, NOT your filesystem root.
QBRIDGE_IMAGE_LOCAL_ROOT=
# Corresponding path visible to the backend; defaults to the same local root.
ONEBOT_IMAGE_LOCAL_ROOT=
